VITE_API_URL=http://localhost:8000

# The hostname this frontend build is deployed to (e.g. app.yourdomain.com).
# Optional, and only needed to support custom EPK domains: when set, the
# app compares it against the real browser hostname on load so a visitor
# arriving via someone's custom domain (CNAMEd at this same build) gets
# routed to their EPK instead of the normal app. Leave unset if you aren't
# using custom domains — everything behaves exactly the same either way.
VITE_APP_HOSTNAME=
