# Production build-time config, checked into git deliberately (unlike .env):
# these VITE_* values get baked into the compiled JS bundle and served to
# every visitor, so they're already public -- there's nothing here to keep
# secret, and committing this file is what stops a plain `npm run build`
# from silently picking up frontend/.env's local dev values (which is
# exactly what happened once already: a rebuild shipped with
# VITE_API_URL=http://localhost:8000 baked into the production bundle).
# Vite automatically prefers this file over .env when the mode is
# "production" (the default for `vite build`), so no extra flags needed.
VITE_API_URL=https://api.karthagopm.com
VITE_APP_HOSTNAME=epk.karthagopm.com
