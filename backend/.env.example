APP_NAME=KORAX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.karthagopm.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot shares the cookie across epk./api. subdomains
SESSION_DOMAIN=.karthagopm.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=smtp
# smtps = implicit TLS, required for port 465 (smtp/STARTTLS would be 587).
MAIL_SCHEME=smtps
MAIL_HOST=epk.karthagopm.com
MAIL_PORT=465
# Secrets — fill these in per-environment, never commit real values here.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@epk.karthagopm.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: only needed if/when S3-compatible storage (S3, Cloudflare R2) is enabled later.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The deployed SPA origin
FRONTEND_URL=https://epk.karthagopm.com
# Comma-separated list of domains allowed to authenticate via Sanctum's stateful (cookie) mode
SANCTUM_STATEFUL_DOMAINS=epk.karthagopm.com

# Optional: only needed to enable real subscriptions — see docs/stripe.md
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Kill switch for Settings → API Tokens — see config/features.php. Set to
# false to reject both new token creation and any already-issued token.
FEATURE_API_TOKENS_ENABLED=true
