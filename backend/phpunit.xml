<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="epk_test"/>
        <env name="DB_USERNAME" value="epk_user"/>
        <env name="DB_PASSWORD" value="EpkDev_2026!Local"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Fake but well-formed: StripeBillingService's HMAC-signed webhook
             verification is genuinely exercised in tests (no network call
             needed for that part), it just needs *a* secret, not Stripe's
             real one. Checkout/portal session creation does call the real
             Stripe API and is mocked in those specific tests instead. -->
        <env name="STRIPE_SECRET" value="sk_test_fake"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="whsec_test_fake_secret"/>
        <env name="STRIPE_PRICE_PRO" value="price_test_pro"/>
        <env name="STRIPE_PRICE_BUSINESS" value="price_test_business"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Independent of whatever .env has it set to locally (see the note
             there) — the suite should always exercise default/enabled
             behavior except in the tests that explicitly flip it off. -->
        <env name="FEATURE_API_TOKENS_ENABLED" value="true"/>
    </php>
</phpunit>
